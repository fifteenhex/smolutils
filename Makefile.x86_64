include common.mk

all: elfs

# Build with NOPIE=1 when using upstream nolibc (as of 7.2).
ifdef NOPIE
STATICPIE = -static
else
STATICPIE = -fpie -static-pie
endif

$(shell echo '$(STATICPIE)' | cmp -s - .buildmode 2>/dev/null || echo '$(STATICPIE)' > .buildmode)
HEADERS += .buildmode

COPTS += -D R_AMD64_RELATIVE=8 -Wl,-z,noseparate-code

# Bit of hand holding for lz4
LZ4INC = -nostdinc -I$(NOLIBCDIR)
LZ4OPTS = -fno-lto
LZ4OPTS += -ffunction-sections -fdata-sections
LZ4LDOPTS = -Wl,--gc-sections

lz4.x86_64.o: thirdparty/lz4/lz4.c thirdparty/lz4/lz4.h .buildmode
	$(MSG) CC thirdparty/lz4/lz4.c
	$(Q)$(CC) \
	$(LZ4INC) \
	$(COPTS) \
	$(LZ4OPTS) \
	$(STATICPIE) \
	-DLZ4_USER_MEMORY_FUNCTIONS \
	-c -o $@ $<

lz4.x86_64.elf.dbg: lz4.c lz4.x86_64.o $(HEADERS)
	$(MSG) CC lz4
	$(Q)$(CC) \
	$(LZ4INC) \
	$(COPTS) \
	$(LZ4OPTS) \
	$(STATICPIE) \
	$(LZ4LDOPTS) \
	-o $@ $< lz4.x86_64.o

.SECONDARY:
%.x86_64.elf.dbg: %.c $(HEADERS)
	$(MSG) CC $*
	$(Q)$(CC) $(COPTS) \
	$(STATICPIE) \
	-o $@ $<

%.x86_64.elf: %.x86_64.elf.dbg
	$(MSG) STRIP $*
	$(Q)$(STRIP) $< -o $@

SYSTEM_ELFS = $(addsuffix .x86_64.elf,$(PROGS_SYSTEM))
SYSTEM_ELFS += $(addsuffix .x86_64.elf,$(PROGS_NET_SYSTEM))
USER_ELFS = $(addsuffix .x86_64.elf,$(PROGS_USER))
USER_ELFS += $(addsuffix .x86_64.elf,$(PROGS_NET_USER))

.PHONY: elfs
elfs: $(SYSTEM_ELFS) $(USER_ELFS) lz4.x86_64.elf

.PHONY: x86_64.tar
x86_64.tar: rootfs.tarwak.json elfs
	$(MSG) TARWAK $@
	$(Q)$(TARWAK) -i rootfs.tarwak.json -o $@ -b ./ -p "%s.x86_64.elf" $(_TARWAKFEATURES)

.PHONY: x86_64.erofs
x86_64.erofs: x86_64.tar
	$(MSG) EROFS $@
	$(Q)$(EROFS_CMD) $@ $<

# Convert the tar into a cpio to use for an initramfs
.PHONY: x86_64.cpio.gz
x86_64.cpio.gz: x86_64.tar
	$(MSG) CPIO $@
	$(Q)bsdtar --format=newc -cf - @$< | gzip -9 > $@

.PHONY: clean
clean:
	$(Q)rm -f .buildmode *.x86_64.o *.x86_64.elf *.x86_64.elf.dbg x86_64.tar x86_64.erofs x86_64.cpio.gz

PROGS ?= $(PROGS_SYSTEM) $(PROGS_USER) $(PROGS_NET_SYSTEM) $(PROGS_NET_USER)

.PHONY: multicall-size
multicall-size:
	CC="$(CC)" COPTS="$(COPTS) $(STATICPIE)" SIZE="$(CROSS_COMPILE)size" \
	PROGS="$(PROGS)" ./multicall-size.sh

# Only check our headers as nolibc upsets clang-tidy.
.PHONY: clang-tidy
clang-tidy:
	$(Q)clang-tidy --header-filter='$(CURDIR)/.*\.h$$' $(C_FILES) -- $(COPTS)

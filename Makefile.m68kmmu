CPU ?= 68040

ifeq ($(filter $(CPU),68030 68040 68060),)
$(error CPU=$(CPU) is not one of 68030, 68040 or 68060)
endif

SMOL_ARCH = $(CPU)

include common.mk

all: elfs

ELFS = $(addsuffix .$(CPU).elf,$(PROGS))

.PHONY: elfs
elfs: $(ELFS)

.PHONY: m68k-$(CPU).tar
m68k-$(CPU).tar: rootfs.tarwak.json elfs $(CONFIGTAGS) $(EXTRA_TARS)
	$(call build_tar,$@,%s.$(CPU).elf)

.PHONY: m68k-$(CPU).erofs
m68k-$(CPU).erofs: m68k-$(CPU).tar
	$(MSG) EROFS $@
	$(Q)$(EROFS_CMD) $@ $<

.PHONY: m68k-$(CPU).cpio.gz
m68k-$(CPU).cpio.gz: m68k-$(CPU).tar
	$(MSG) CPIO $@
	$(Q)bsdtar --format=newc -cf - @$< | gzip -9 > $@

.PHONY: clean
clean:
	$(Q)rm -f .buildmode.68030 .buildmode.68040 .buildmode.68060 .localconfig.68030 .localconfig.68040 .localconfig.68060 $(CONFIGTAGS)
	$(Q)rm -f *.68030.elf *.68040.elf *.68060.elf
	$(Q)rm -f *.68030.elf.dbg *.68040.elf.dbg *.68060.elf.dbg
	$(Q)rm -f m68k-680[346]0.tar m68k-680[346]0.erofs m68k-680[346]0.cpio.gz

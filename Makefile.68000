SMOL_ARCH = 68000
SMOL_LIBS = libgcc_68000.a

include common.mk

HEADERS += libgcc_68000.a

all: elfs

#	-ffunction-sections \
#	-fdata-sections \


#	-fno-stack-protector \

#	-I_build/headers/include

#%.elf.dbg: %.pie.o
#	$(BFDLD) \
#		--gc-sections \
#		--print-gc-sections \
#		--no-dynamic-linker \
#		--hash-style=gnu \
#		--undefined=_start_c \
#		-pie $^ -o $@


#	-Wl,--no-dynamic-linker \

.PHONY: system_elfs user_elfs
ELFS = $(addsuffix .68000.elf,$(PROGS))

elfs: $(ELFS)

.PHONY: m68k.tar
m68k.tar: rootfs.tarwak.json elfs $(CONFIGTAGS) $(EXTRA_TARS)
	$(call build_tar,$@,%s.68000.elf)

.PHONY: m68k.erofs
m68k.erofs: m68k.tar
	$(MSG) EROFS $@
	$(Q)$(EROFS_CMD) $@ $<

.PHONY: m68k.cpio.gz
m68k.cpio.gz: m68k.tar
	$(MSG) CPIO $@
	$(Q)bsdtar --format=newc -cf - @$< | gzip -9 > $@

.PHONY: m68k.cpio
m68k.cpio: m68k.tar
	$(MSG) CPIO $@
	$(Q)bsdtar --format=newc -cf $@ @$<

.PHONY: clean
clean:
	$(Q)rm -f $(SMOL_BUILDMODE) $(LOCAL_CONFIG_STAMP) $(CONFIGTAGS) *.o *.gdb *.68000.elf *.68000.elf.dbg m68k.tar m68k.erofs
	$(Q)rm -f m68k.cpio m68k.cpio.gz

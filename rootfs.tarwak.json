{
	"groups": {
		"users": 1024
	},
	"defaults": {
		"user": "root",
		"group": "root"
	},
	"root": {
		"entities": {
			"init": {
				"type": "symlink",
				"target": "/sbin/init",
				"feature": "initramfs"
			},
                	"dev" : {
				"type": "dir"
			},
			"bin" : {
                        	"type": "dir",
				"mode": "0555",
				"defaults": {
					"mode": "0555"
				},
				"entities": {
					"cat": {
						"type": "symlink",
						"target": "/lib/smol/files"
					},
					"cp": {
						"type": "symlink",
						"target": "/lib/smol/files"
					},
					"chmod": {
						"type": "symlink",
						"target": "/lib/smol/files"
					},
					"chown": {
						"type": "symlink",
						"target": "/lib/smol/files"
					},
					"df": { },
					"dmesg": { },
					"smolsh": { },
					"xxd": { },
					"man": { },
					"less": { },
					"uname": { },
					"touch": {
						"type": "symlink",
						"target": "/lib/smol/files"
					},
					"kill": { },
					"ls": { },
					"ps": { },
					"sha256sum": { },
					"ip": {
						"feature": "net"
					},
					"resolv": {
						"feature": "net"
					},
					"devmem": {
						"xattrs": {
						}
					},
					"tftp": {
						"feature": "net"
					},
					"uname": { },
					"ping": {
						"feature": "net",
						"xattrs": {
							"security.capability": "cap_net_raw+ep"
						}
					},
					"su": {
						"xattrs": {
							"security.capability": "cap_setuid,cap_setgid+ep"
						}
					},
					"reboot": {
						"type": "symlink",
						"target": "/sbin/init"
					},
					"poweroff": {
						"type": "symlink",
						"target": "/sbin/init"
					},
					"halt": {
						"type": "symlink",
						"target": "/sbin/init"
					},
					"mount": { },
					"umount": {
						"type": "symlink",
						"target": "/bin/mount"
					},
					"rmdir": {
						"type": "symlink",
						"target": "/lib/smol/files"
					},
					"mkdir": {
						"type": "symlink",
						"target": "/lib/smol/files"
					},
					"ln": {
						"type": "symlink",
						"target": "/lib/smol/files"
					},
					"rm": {
						"type": "symlink",
						"target": "/lib/smol/files"
					},
					"mv": {
						"type": "symlink",
						"target": "/lib/smol/files"
					}
				}
                	},
                	"proc" : {
				"type": "dir"
			},
                	"run" : {
				"type": "dir"
			},
			"lib" : {
				"type": "dir",
				"mode": "0555",
				"entities": {
					"smol": {
						"type": "dir",
						"mode": "0555",
						"defaults": {
							"mode": "0555"
						},
						"entities": {
							"files": { }
						}
					}
				}
			},
                	"sbin" : {
				"type": "dir",
				"mode": "0711",
				"defaults": {
					"mode": "0500"
				},
				"entities": {
					"getty": { },
					"insmod": {
						"feature": "modules"
					},
					"startup": { },
					"sntp": {
						"feature": "net"
					},
					"dhcpc": {
						"feature": "net"
					},
					"telnetd": {
						"feature": "telnetd"
					},
					"init": {
						"group": "users",
						"mode": "0750",
						"xattrs": {
							"security.capability": "cap_kill+ep"
						}
					}
				}
			},
                	"tmp" : {
				"type": "dir"
			},
                	"sys" : {
				"type": "dir"
			}
		}
	}
}
